# Force LF for all text files
*       text=auto eol=lf

# Binary files - no conversion
*.png   -text
*.exe   -text
*.dll   -text
*.lib   -text
*.obj   -text
*.pdb   -text
*.res   -text

# Windows batch files require CRLF; treat as binary so git stores the bytes
# verbatim and never converts line endings in either direction.
*.cmd   -text
*.bat   -text
