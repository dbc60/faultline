# See https://git-scm.com/docs/gitignore for details

# Fossil SCM
_FOSSIL_

# build artifacts
target/

# WinMerge
*.bak

# Doxygen generated files
docs/html/

# RemedyBG debugger session-files
*.rdbg

# Obsidian
*/.obsidian

# Visual Studio and VS Code
.vscode
.vs

# Team-shared config (settings.json, skills, agents) is tracked by git and personal
# overrides that are in settings.local.json stay local. Note that git cannot re-include
# anything under an excluded DIRECTORY, so this has to exclude the children (.claude/*)
# rather than the directory itself (.claude/).
.claude/*
!.claude/agents/
!.claude/settings.json
!.claude/skills/
!.claude/hooks/

# Experiments with agents
_ai_team/

# Distribution packages (generated by build\cmd\*_dist.cmd)
/dist/

# Test results
test/
test_sh/
test_clang/
ctime/
metrics/

# Other
*.sqlite
*.log
git-commit*.txt
2???-??-??-*.txt
