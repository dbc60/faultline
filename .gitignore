# See https://git-scm.com/docs/gitignore for details

# Fossil SCM
_FOSSIL_

# build artifacts
target/

# WinMerge
*.bak

# Doxygen generated files
docs/html/

# RemedyBG debugger session-files
*.rdbg

# Obsidian
*/.obsidian

# Visual Studio and VS Code
.vscode
.vs

# Team-shared config (settings.json, skills, agents) is tracked by git and personal
# overrides that are in settings.local.json stay local. Note that git cannot re-include
# anything under an excluded DIRECTORY, so this has to exclude the children (.claude/*)
# rather than the directory itself (.claude/).
.claude/*
!.claude/agents/
!.claude/settings.json
!.claude/skills/
!.claude/hooks/

# Experiments with agents
_ai_team/

# Distribution packages (generated by build\cmd\all_dist.cmd, or one package's
# build\cmd\<name>_dist.cmd). Only each package's manifest.txt is tracked: it records
# the package's file list with a SHA-256 per file, plus its version and dependencies,
# so a commit that changes what a package ships shows up as a manifest diff. The
# copied sources are byte-identical to their originals under src\ and include\, so
# tracking them too would only restate every source diff once per package that
# ships the file. As with .claude above, git cannot re-include anything under an
# excluded DIRECTORY, so the package directories are re-included before their
# manifests are.
/dist/**
!/dist/*/
!/dist/*/manifest.txt

# Test results
test/
test_sh/
test_clang/
bench/
ctime/
metrics/

# Other
*.sqlite
*.log
git-commit*.txt
2???-??-??-*.txt
